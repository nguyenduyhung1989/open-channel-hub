# When run directly, the API binds to loopback by default. Remote access requires a separate TLS reverse proxy.
# Compose overrides HOST to 0.0.0.0 inside the container, but publishes the host port only at 127.0.0.1.
HOST=127.0.0.1
PORT=3000
# Optional host-side override for a second local Compose stack. The container still listens on 3000.
API_HOST_PORT=3000

# Required when NODE_ENV=production, including the Compose service. It must be the public, unauthenticated,
# exact corresponding-source URL for the version actually running, with HTTPS and no username, password,
# query string, fragment, or secret. A modified fork or SaaS must not use the upstream URL as a placeholder.
SOURCE_OFFER_URL=

# Compose uses these as Docker secrets only; neither password enters the API process environment.
# Generate two different 32-512-character values. `POSTGRES_PASSWORD` is for PostgreSQL bootstrap only;
# `DATABASE_PASSWORD` belongs to the non-superuser `open_channel_hub` application role.
POSTGRES_PASSWORD=
DATABASE_PASSWORD=

# Phase 1a is disabled by default. Enable it only after placing every required secret in the Git-ignored `.env` file.
TELEGRAM_BOT_ENABLED=false

# Never put real tokens in this example, shell commands, issues, pull requests, or logs.
# When TELEGRAM_BOT_ENABLED=true, all of these values are required:
# TELEGRAM_BOT_TOKEN, OPERATOR_API_TOKEN (32-512 characters), and TELEGRAM_WEBHOOK_SECRET (32-256 characters).
TELEGRAM_BOT_TOKEN=
OPERATOR_API_TOKEN=
TELEGRAM_CONNECTION_ID=telegram-bot-default
TELEGRAM_WEBHOOK_SECRET=

# Optional. Leave blank until webhook registration is intentionally performed. If set, it must be an absolute public
# HTTPS URL for /v1/webhooks/telegram-bot with no username, password, query string, fragment, or secret in the URL.
# Starting Compose does not provide TLS or register a webhook automatically; follow the operations guide for an authorized registration.
TELEGRAM_WEBHOOK_URL=

# Compose multi-connection mode. Leave blank to disable it. It must be the unpadded base64url encoding of the exact JSON
# document below. Base64url prevents Compose `.env` interpolation from expanding `$` inside a credential; it is NOT encryption.
# The encoded value still holds real credentials, so keep it only in this Git-ignored local file or a deployment secret store; never
# commit, print, or paste it in a shell command. Compose writes only the encoded value to /run/secrets/runtime_connections_base64
# and sets CONNECTIONS_CONFIG_BASE64_FILE inside the API container; the value is never an API environment variable.
# The decoded JSON has this exact shape (replace all placeholder strings locally; the example intentionally contains no values):
# {"version":1,"connections":[{"id":"telegram-bot-support","type":"telegram_bot","botToken":"...","operatorApiToken":"...","webhookSecret":"...","webhookUrl":"https://example.invalid/v1/webhooks/telegram-bot/telegram-bot-support"},{"id":"zalo-oa-support","type":"zalo_oa","appId":"...","oaId":"...","oaSecretKey":"...","operatorApiToken":"...","webhookUrl":"https://example.invalid/v1/webhooks/zalo-oa"},{"id":"facebook-page-support","type":"facebook_page","appId":"...","pageId":"...","appSecret":"...","webhookVerifyToken":"...","operatorApiToken":"...","webhookUrl":"https://example.invalid/v1/webhooks/facebook-page"},{"id":"whatsapp-business-support","type":"whatsapp_business","appId":"...","wabaId":"...","phoneNumberId":"...","appSecret":"...","webhookVerifyToken":"...","operatorApiToken":"...","webhookUrl":"https://example.invalid/v1/webhooks/whatsapp-business"}],"inboxes":[{"id":"support-inbox","token":"...","connectionIds":["facebook-page-support","telegram-bot-support","whatsapp-business-support","zalo-oa-support"]}]}
# Every multi-connection id uses 1-128 letters, digits, ., _, :, or -, but it must not be `.` or `..` because it is part of a dynamic webhook path.
# Every Zalo OA entry needs its documented `appId`, `oaId`, `oaSecretKey`, and a unique operator token. Its public `webhookUrl`, if present,
# is exactly `https://your-public-host/v1/webhooks/zalo-oa`; Zalo selects the configured OA from the signed payload, never a URL path segment.
# The `(appId, oaId)` pair and all operator tokens must be unique. A Zalo OA secret must not collide with an operator or Telegram credential.
# Several Zalo OA entries may have the same or different OA secrets; do not infer a secret-sharing rule from a shared App ID. Configure the
# secret that belongs to each OA connection.
# A Facebook Page entry needs decimal `appId` and `pageId`, plus `appSecret`, `webhookVerifyToken`, and a unique operator token.
# A Page ID must be unique. Several Pages may share one App only when both App credentials are exactly equal. Each credential is
# 32-512 printable characters and must not collide with a credential in another role, App, Telegram Bot, or Zalo OA entry. Its fixed
# public `webhookUrl`, if present, is either `https://your-public-host/v1/webhooks/facebook-page` or the shared
# `https://your-public-host/v1/webhooks/meta`, with no username, password, query, fragment, or secret. The POST payload selects
# configured Pages server side; an HTTP caller never chooses an internal connection ID.
# A WhatsApp Business entry needs decimal `appId`, `wabaId`, and `phoneNumberId`, plus `appSecret`, `webhookVerifyToken`, and a unique
# operator token. Phone-number IDs are unique. One WABA must resolve to one configured Meta App; multiple business phone numbers and WABAs
# may share that App only when its App credentials are exactly equal. Its public `webhookUrl`, if present, is either
# `https://your-public-host/v1/webhooks/whatsapp-business` or the shared `https://your-public-host/v1/webhooks/meta`, with no username,
# password, query, fragment, or secret. The signed POST payload selects configured WABAs and business phone numbers server side; an HTTP
# caller never chooses an internal connection ID.
# The same configured Meta App may appear in Facebook Page and WhatsApp Business entries only with the exact same `appSecret` and
# `webhookVerifyToken`. If it has both entry types, every declared `webhookUrl` must be the exact same public
# `https://your-public-host/v1/webhooks/meta`; any of them may be omitted when no registration URL is declared. Those credentials must not
# collide with another App, a different credential role, Telegram Bot, or Zalo OA entry.
# Optional `inboxes` creates one to one hundred read-only aggregate feeds. Each inbox needs an opaque `id`, one unique 32-512-character
# printable `token`, and one to one hundred unique `connectionIds` already declared above. An inbox token must not equal any connection
# credential or another inbox token. Its IDs are a server-selected allow-list for `GET /v1/inbox/inbound-events`; callers cannot
# select an inbox ID or a connection ID. The inbox has no user login, role model, write capability, dashboard, or provider credential.
# Do not set this together with TELEGRAM_BOT_ENABLED=true or a nonblank TELEGRAM_BOT_TOKEN, OPERATOR_API_TOKEN,
# TELEGRAM_WEBHOOK_SECRET, or TELEGRAM_WEBHOOK_URL. TELEGRAM_CONNECTION_ID is ignored in this mode.
# For direct or other non-Compose runs, put raw JSON in the ignored runtime-connections.local.json (or a mounted secret outside this repository)
# and set CONNECTIONS_CONFIG_FILE to its absolute path. Compose deliberately does not use that raw file path.
CONNECTIONS_CONFIG_BASE64=
