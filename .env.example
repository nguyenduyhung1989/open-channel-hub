# When run directly, the API binds to loopback by default. Remote access requires a separate TLS reverse proxy.
# Compose overrides HOST to 0.0.0.0 inside the container, but publishes the host port only at 127.0.0.1.
HOST=127.0.0.1
PORT=3000
# Optional host-side override for a second local Compose stack. The container still listens on 3000.
API_HOST_PORT=3000

# Required when NODE_ENV=production, including the Compose service. It must be the public, unauthenticated,
# exact corresponding-source URL for the version actually running, with HTTPS and no username, password,
# query string, fragment, or secret. A modified fork or SaaS must not use the upstream URL as a placeholder.
SOURCE_OFFER_URL=

# Compose uses these as Docker secrets only; neither password enters the API process environment.
# Generate two different 32-512-character values. `POSTGRES_PASSWORD` is for PostgreSQL bootstrap only;
# `DATABASE_PASSWORD` belongs to the non-superuser `open_channel_hub` application role.
POSTGRES_PASSWORD=
DATABASE_PASSWORD=

# Phase 1a is disabled by default. Enable it only after placing every required secret in the Git-ignored `.env` file.
TELEGRAM_BOT_ENABLED=false

# Never put real tokens in this example, shell commands, issues, pull requests, or logs.
# When TELEGRAM_BOT_ENABLED=true, all of these values are required:
# TELEGRAM_BOT_TOKEN, OPERATOR_API_TOKEN (32-512 characters), and TELEGRAM_WEBHOOK_SECRET (32-256 characters).
TELEGRAM_BOT_TOKEN=
OPERATOR_API_TOKEN=
TELEGRAM_CONNECTION_ID=telegram-bot-default
TELEGRAM_WEBHOOK_SECRET=

# Optional. Leave blank until webhook registration is intentionally performed. If set, it must be an absolute public
# HTTPS URL for /v1/webhooks/telegram-bot with no username, password, query string, fragment, or secret in the URL.
# Starting Compose does not provide TLS or register a webhook automatically; follow the operations guide for an authorized registration.
TELEGRAM_WEBHOOK_URL=

# Phase 2c Compose multi-connection mode. Leave blank to disable it. It must be the unpadded base64url encoding of the exact JSON
# document below. Base64url prevents Compose `.env` interpolation from expanding `$` inside a credential; it is NOT encryption.
# The encoded value still holds real credentials, so keep it only in this Git-ignored local file or a deployment secret store; never
# commit, print, or paste it in a shell command. Compose writes only the encoded value to /run/secrets/runtime_connections_base64
# and sets CONNECTIONS_CONFIG_BASE64_FILE inside the API container; the value is never an API environment variable.
# The decoded JSON has this exact shape (replace all placeholder strings locally; the example intentionally contains no values):
# {"version":1,"connections":[{"id":"telegram-bot-support","type":"telegram_bot","botToken":"...","operatorApiToken":"...","webhookSecret":"...","webhookUrl":"https://example.invalid/v1/webhooks/telegram-bot/telegram-bot-support"}]}
# Every multi-connection id uses 1-128 letters, digits, ., _, :, or -, but it must not be `.` or `..` because it is part of a dynamic webhook path.
# Tokens and webhook secrets must be unique across all entries.
# Do not set this together with TELEGRAM_BOT_ENABLED=true or a nonblank TELEGRAM_BOT_TOKEN, OPERATOR_API_TOKEN,
# TELEGRAM_WEBHOOK_SECRET, or TELEGRAM_WEBHOOK_URL. TELEGRAM_CONNECTION_ID is ignored in this mode.
# For direct or other non-Compose runs, put raw JSON in the ignored runtime-connections.local.json (or a mounted secret outside this repository)
# and set CONNECTIONS_CONFIG_FILE to its absolute path. Compose deliberately does not use that raw file path.
CONNECTIONS_CONFIG_BASE64=
