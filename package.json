{
  "name": "open-channel-hub",
  "version": "0.1.0",
  "description": "Open-source, self-hostable omnichannel messaging hub with official-first connectors.",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "db:migrate": "node --env-file-if-exists=.env apps/api/dist/db/migrate.js",
    "db:migrate:dev": "node --env-file-if-exists=.env --import tsx apps/api/src/db/migrate.ts",
    "dashboard:password:hash": "node apps/api/dist/dashboard/password-hash-cli.js",
    "dashboard:password:hash:dev": "node --import tsx apps/api/src/dashboard/password-hash-cli.ts",
    "dev": "node --env-file-if-exists=.env --import tsx apps/api/src/server.ts",
    "start": "node --env-file-if-exists=.env apps/api/dist/server.js",
    "zalo-user:bridge:dev": "node --env-file-if-exists=.env --import tsx apps/zalo-user-bridge/src/main.ts",
    "telegram:webhook:set": "node --env-file-if-exists=.env apps/api/dist/telegram-bot/set-webhook.js",
    "telegram:webhook:set:dev": "node --env-file-if-exists=.env --import tsx apps/api/src/telegram-bot/set-webhook.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.0",
    "argon2": "0.45.1",
    "fastify": "5.11.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "globals": "17.10.0",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "6.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
